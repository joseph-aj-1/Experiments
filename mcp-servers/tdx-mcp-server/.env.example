# Copy to .env and fill in. .env stays on your PC (or in Secret Manager); never commit it.

# 3DPassport sign-in (the server signs in as you)
TDX_USERNAME=your-3dpassport-username
TDX_PASSWORD=your-3dpassport-password

# Role.Organization.Collaborative space
SecurityContext=VPLMProjectLeader.Company Name.Common Space

# API Gateway key (EIF agent key)
APIKey=

# Tenant addresses
TDX_APIGATEWAY_URL=https://oi000629352-eu1-apigateway.3dexperience.3ds.com
TDX_BASE_URL=https://oi000629352-eu1-space.3dexperience.3ds.com/enovia
TDX_TENANT=OI000629352
TDX_SERVER_PREFERENCE=APIGateway
TDX_VERIFY_SSL=true
TDX_TIMEOUT_SECONDS=30

# --- Remote mode only (Cloud Run); see DEPLOY-CLOUDRUN.md ---
# TDX_AUTH=github
# TDX_PUBLIC_URL=https://<service>.run.app
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# TDX_ALLOWED_GITHUB_USERS=joseph-aj-1
# TDX_JWT_SIGNING_KEY=
