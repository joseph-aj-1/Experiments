# Copy to .env. Everything here is optional; the defaults work out of the box.

# Where the Catia Magic plugin writes its port + secret token at startup.
# MAGIC_BRIDGE_TOKEN_FILE=C:\Users\<you>\.magic-mcp\bridge.json

# Force a port (must match -Dmagicbridge.port in Catia Magic if you changed it).
# MAGIC_BRIDGE_PORT=8765

# Seconds to wait for Catia Magic to answer.
MAGIC_TIMEOUT_SECONDS=60

# true = only expose the read tools (no create/update/delete/save).
MAGIC_READ_ONLY=false

# false = hide delete_element even when edits are allowed.
MAGIC_ALLOW_DELETE=true
