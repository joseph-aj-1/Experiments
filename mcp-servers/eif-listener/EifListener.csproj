<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EifListener</RootNamespace>
    <!-- Run on .NET 7 or any newer runtime installed on the machine -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same JMS client Dassault's EIF samples use (OpenWire over SSL to the EIF broker) -->
    <PackageReference Include="Apache.NMS.ActiveMQ" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
