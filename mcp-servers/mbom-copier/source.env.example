# SOURCE tenant: where the MBOM is read from (never written to).
# Copy to source.env and fill in. Your tdx-mcp-server .env works as-is.
# source.env stays on your PC; never commit it.

TDX_USERNAME=your-3dpassport-username
TDX_PASSWORD=your-3dpassport-password

# Role.Organization.Collaborative space on this tenant
SecurityContext=VPLMProjectLeader.Company Name.Common Space

# MCPAgent key from Agent Management on this tenant
APIKey=

TDX_APIGATEWAY_URL=https://oi000629352-eu1-demo-apigateway.3dexperience.3ds.com
TDX_BASE_URL=https://oi000629352-eu1-demo-space.3dexperience.3ds.com/enovia
TDX_TENANT=OI000629352
TDX_SERVER_PREFERENCE=APIGateway
TDX_VERIFY_SSL=true
TDX_TIMEOUT_SECONDS=60
