# Configured MBOM Builder: your 3DEXPERIENCE connection. Copy to .env and fill in.
# .env stays on your PC; never share it or put it in the zip.

# 3DPassport sign-in (the builder signs in as you)
TDX_USERNAME=your.3dexperience.username
TDX_PASSWORD=your-password

# Role.Organization.Collaborative space to work in (as shown in the 3DEXPERIENCE role menu)
SecurityContext=VPLMProjectLeader.Company Name.Common Space

# API Gateway key for the tenant (ask your 3DEXPERIENCE administrator)
APIKey=

# Tenant addresses (replace oi000629352 / eu1 with your tenant and region)
TDX_APIGATEWAY_URL=https://oi000629352-eu1-demo-apigateway.3dexperience.3ds.com
TDX_BASE_URL=https://oi000629352-eu1-demo-space.3dexperience.3ds.com/enovia
TDX_TENANT=OI000629352

TDX_SERVER_PREFERENCE=APIGateway
TDX_VERIFY_SSL=true
TDX_TIMEOUT_SECONDS=60
