# TARGET tenant: Lighthouse (R1132100000770, us1). The copy is created here.
# Copy to target.env and fill in. target.env stays on your PC; never commit it.

# Your 3DPassport login for Lighthouse (us1 is a different region from your eu1 demo
# tenant, so this may be a different username/password)
TDX_USERNAME=your-lighthouse-username
TDX_PASSWORD=your-lighthouse-password

# Role.Organization.Collaborative space on Lighthouse with rights to create
# Manufacturing Items (as shown in the role menu at the top right of the dashboard)
SecurityContext=Role.Organization.Collaborative space

# Key of the MCPAgent agent (Agent Management on Lighthouse) - the key, not the agent ID
APIKey=

TDX_APIGATEWAY_URL=https://r1132100000770-us1-apigateway.3dexperience.3ds.com
TDX_BASE_URL=https://r1132100000770-us1-space.3dexperience.3ds.com/enovia
TDX_TENANT=R1132100000770
TDX_SERVER_PREFERENCE=APIGateway
TDX_VERIFY_SSL=true
TDX_TIMEOUT_SECONDS=60
